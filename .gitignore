node_modules/
.env

# Virtual Environment
venv/
.venv/
env/

# Model weights (large files)
*.pt
models/*.pt
models/*.pth
models/*.task
yolov8x.pt

# Python cache
__pycache__/
*.pyc
*.pyo
**/__pycache__/

# IDE
.vscode/
.idea/

# Training runs and logs
runs/
runs/detect/train/

# Cached detections. These are per-video caches; shipping one means a newcomer runs
# against a different video's detections unless they know to pass --no-stubs.
tracker_stubs/*.pkl

# Roboflow training data (large)
training/tennis-ball-detection-6/

# OS files
.DS_Store
Thumbs.db

# ── Local-only dev files (not for contributors) ──
CLAUDE.md

# docs/ is the internal record: the engineering journal, specs, scratch analysis and
# unfinished reasoning. It stays private. Public reproducibility is not the same thing
# as a public internal journal, so the carve-out below is deliberately narrow: only
# docs/public/ ships, and only material written to be read by a stranger goes in it.
#
# If a production comment cites a private path under docs/, fix the comment. Do not
# widen this rule to make the citation resolve.
docs/*
!docs/public/
learning_notes/
analysis/
audit_frames/
fresh_run.log
*.log

# Pipeline output (generated, not source)
output/
output_videos/
logs/

# Tracker stubs (large binary cache — regenerated by pipeline)
tracker_stubs/

# Third-party repos cloned under external/
external/

# External/pulled datasets (large, not project source — see docs/specs/phase_3)
# datasets/labels/ (our own hand labels, small CSVs) is intentionally NOT ignored.
datasets/external/

# tools/frame_strip.py output: throwaway contact-sheet images for reviewing a labelling
# gap by eye. Not a deliverable, and not needed once the CSV they helped produce is done.
datasets/labels/_review/

# Evaluation footage: large binaries, and third-party broadcast material we only
# hold locally for testing. The manifests and the eval scripts are the reproducible
# part and are tracked; the video is not redistributed through this repo.
datasets/evail_clips/
datasets/serve_clips/
datasets/source_videos/

# Claude Code local session data
.claude/

# Debug/scratch files
tracknet_eval_debug.txt

# Footage dropped in the repo root for a quick run. The clips under input_videos/ are the
# tracked reference ones; anything at the top level is somebody's own recording and is
# usually hundreds of megabytes.
/*.mp4
/*.avi
/*.mov
/*.mkv

# Patch files exported while moving work between machines.
/*.patch

# tools/segment_points.py output: the default <video name>_points/ directory it
# writes cut clips and manifest.json into. Generated, and often hundreds of MB.
*_points/

# tools/batch_analyze.py output: the default <input name>_analysis/ directory,
# holding one folder of stats per clip plus the combined batch_report.*.
*_analysis/

# The full 165-clip batch run against asd_points/ (Fase 3a) - named with a
# _full suffix so it doesn't collide with the user's own smaller test runs in
# asd_analysis/, which means it falls outside the *_analysis/ glob above.
/asd_analysis_full/

# Personal prep / private notes (never commit)
prep_james/
image.png
image copy.png
image copy 2.png
*.png.txt
2026-*-research-*.txt

# Model weights live in Hugging Face and are fetched by scripts/download_models.py.
# models/ keeps only small tracked data files (classifier weights as JSON).
models/*.txt

# Both spellings of the eval-clip directory (the typo'd one predates the rename).
datasets/eval_clips/

# Held-out launch benchmark. The CLIPS are third-party broadcast footage and are not
# redistributed, exactly like every other clip directory here. The MANIFEST and the
# RESULTS are the reproducible part and are tracked deliberately: the manifest states the
# arithmetic selection rule and the frozen timestamps, so anyone with the source video
# can rebuild the identical set and check the numbers against results.json.
datasets/heldout/clips/
datasets/heldout/segments/
!datasets/heldout/manifest.json
!datasets/heldout/results.json

# Pipeline output and scratch analysis — generated, not source.
output_videos/
analysis/

# Python packaging artifacts (produced by `python -m build` / `pip install -e .`)
build/
dist/
*.egg-info/

# Optional SAM 3D Body weights (Meta SAM License, gated, not redistributed)
models/sam3d_body/
.gstack/
